# MongoDB connection
# Local:    mongodb://localhost:27017
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=strivenest

# JWT
JWT_SECRET=change_this_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Future public Employee Registration Form portal
EMPLOYEE_PORTAL_URL=http://localhost:3002

# development (default) or production.
# The app REFUSES TO START if this is "production" while DEMO_MODE=true.
ENVIRONMENT=development

# Enables the fixed/mock mobile-OTP login (no real SMS provider is called)
# and the SEED_* demo accounts below. Set to false before any production
# deployment -- do this in addition to, not instead of, setting
# ENVIRONMENT=production; both together are what disable demo auth.
DEMO_MODE=true

# SuperAdmin seed account (used by seed_superadmin.py, and automatically on
# every backend startup -- see server.py's lifespan). This guarantees a
# working SuperAdmin login account always exists.
#
# development (ENVIRONMENT unset or "development"): SEED_SUPERADMIN_EMAIL /
#   SEED_SUPERADMIN_PASSWORD are OPTIONAL and default to the values below
#   (a well-known, publicly documented demo login -- fine for local use).
#
# *** PRODUCTION (ENVIRONMENT=production): BOTH ARE REQUIRED. ***
#   The app now REFUSES TO START if either is missing in production -- there
#   is no default SuperAdmin password in production. Set both, on Render, to
#   a real email you control and a strong, private password:
#     SEED_SUPERADMIN_EMAIL=<a real admin email you control>
#     SEED_SUPERADMIN_PASSWORD=<a strong, private password -- NOT SuperAdmin@123>
#   Do this in the Render dashboard's Environment tab for the backend
#   service, not in this file (never commit real production credentials).
SEED_SUPERADMIN_EMAIL=superadmin@strivenest.com
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_SUPERADMIN_MOBILE=9876543210
SEED_SUPERADMIN_NAME=Super Admin

# Demo OTP (development only - never use in production). Only reachable
# while DEMO_MODE=true; see services/auth_service.py.
DEMO_OTP=123456

# Demo SubAdmin seed account (used only by seed_subadmin.py).
# NOTE: unlike SEED_SUPERADMIN_* above, this is NOT currently enforced as
# required in production -- it is a demo/testing account, not a production
# admin identity. seed_subadmin.py still seeds it whenever DEMO_MODE=false
# (the required production setting), so if you deploy to production, either
# set SEED_SUBADMIN_PASSWORD to a private value or remove the
# `python seed_subadmin.py` / automatic seed step. See FIXES_APPLIED.md.
SEED_SUBADMIN_EMAIL=subadmin@gmail.com
SEED_SUBADMIN_PASSWORD=Subadmin@12
SEED_SUBADMIN_MOBILE=9876543212
SEED_SUBADMIN_NAME=Sub Admin

# Demo Employee seed account (used only by seed_demo_employee.py). Created via
# the real application -> SuperAdmin-approval flow, not a separate mechanism.
# NOTE: same caveat as SEED_SUBADMIN_PASSWORD above -- not currently enforced
# as required in production. Set SEED_EMPLOYEE_PASSWORD to a private value
# before a production deployment. See FIXES_APPLIED.md.
SEED_EMPLOYEE_EMAIL=employee.demo@strivenest.com
SEED_EMPLOYEE_PASSWORD=Employee@123
SEED_EMPLOYEE_MOBILE=9876543211
SEED_EMPLOYEE_NAME=Demo Employee
